# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AWS / Cognito — store in .env.local (gitignored) or Vercel environment settings
VITE_API_BASE_URL="https://4tsr153t0m.execute-api.ap-northeast-1.amazonaws.com/dev"
VITE_COGNITO_USER_POOL_ID="ap-northeast-1_XXXXXXXXX"
VITE_COGNITO_CLIENT_ID="your_cognito_app_client_id"

# TIPS bridge (server/, `npm run bridge`). All optional; defaults shown.
# TIPS_BRIDGE_PORT=8791                 # bridge listens on 127.0.0.1 only
# TIPS_HUB_SESSION_MINUTES=160          # Hub session length before sign-in is required again
# Hosted mode (scripts/hub.sh sets these from ~/.tokaihub/hub.env; do not put real values here)
# TIPS_PERSIST=0                        # 1 = seal the Microsoft/TIPS cookies to ~/.tokaihub (AES-256-GCM)
# TIPS_PUBLIC_PORT=8792                 # public listener, the Cloudflare tunnel's target
# HUB_OWNER_ID=                         # the only TIPS student ID the Hub accepts
# HUB_APP_ORIGIN=                       # hosted app origin, e.g. https://tokaihub.example.com (passkeys bind to it)
# VITE_TIPS_BRIDGE_URL is set for production builds in .env.production
# VITE_TIPS_BRIDGE_URL=/tips-api        # frontend base URL for the bridge (Vite proxies it in dev)
